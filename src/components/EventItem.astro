---
import { months, localePath, type Locale } from '../i18n/config';
const { e, locale } = Astro.props as { e: any; locale: Locale };
const d = e.data.date as Date;
const meta = [e.data.time, e.data.place].filter(Boolean).join(' · ');
---
<a class="ev" href={localePath(locale, `/events/${e.id}`)}>
  <div class="bd"><b>{d.getUTCDate()}</b><span>{months[locale][d.getUTCMonth()]}</span></div>
  <div class="evt"><div class="et">{e.data.title}</div>{meta && <div class="ep">{meta}</div>}</div>
  {e.data.image && <img class="evimg" src={e.data.image} alt="" loading="lazy" width="84" height="47" />}
</a>
