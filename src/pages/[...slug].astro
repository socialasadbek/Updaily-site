---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Row from '../components/Row.astro';
import Share from '../components/Share.astro';
import Ad from '../components/Ad.astro';
import EventItem from '../components/EventItem.astro';
import { locales, defaultLocale, categories, localePath, months, t, type Locale } from '../i18n/config';
import { allArticles, byLocale, slugOf, alternates, readMin, fmtDate, articleUrl, eventsFor, getPage, PAGE_SLUGS, settings } from '../lib/content';

export async function getStaticPaths() {
  const all = await allArticles();
  const authors = await getCollection('authors');
  const events = await getCollection('events');
  const out: any[] = [];
  for (const l of locales) {
    const pre = l === defaultLocale ? '' : l;
    const j = (p: string) => [pre, p].filter(Boolean).join('/') || undefined;
    out.push({ params: { slug: j('') }, props: { type: 'home', locale: l } });
    out.push({ params: { slug: j('search') }, props: { type: 'search', locale: l } });
    out.push({ params: { slug: j('events') }, props: { type: 'events', locale: l } });
    out.push({ params: { slug: j('rates') }, props: { type: 'rates', locale: l } });
    for (const c of categories) out.push({ params: { slug: j(`c/${c}`) }, props: { type: 'category', locale: l, category: c } });
    for (const p of PAGE_SLUGS) out.push({ params: { slug: j(p) }, props: { type: 'page', locale: l, page: p } });
    for (const a of authors) out.push({ params: { slug: j(`author/${a.id}`) }, props: { type: 'author', locale: l, authorId: a.id } });
    for (const e of events) if (e.data.lang === 'all' || e.data.lang === l) out.push({ params: { slug: j(`events/${e.id}`) }, props: { type: 'event', locale: l, eventId: e.id } });
    for (const a of byLocale(all, l)) out.push({ params: { slug: j(`a/${slugOf(a)}`) }, props: { type: 'article', locale: l, id: a.id } });
  }
  return out;
}

const { type, locale, category, id, page, authorId, eventId } = Astro.props as {
  type: string; locale: Locale; category?: string; id?: string; page?: string; authorId?: string; eventId?: string;
};
const all = await allArticles();
const mine = byLocale(all, locale);
const authors = await getCollection('authors');
const L = (p = '/') => localePath(locale, p);
const allLocales = (p: string) => Object.fromEntries(locales.map((l) => [l, localePath(l, p)]));
const site = Astro.site!.toString().replace(/\/$/, '');
const contact = (settings as any).contact;
const ratesScript = `
function loadRates(){
  fetch('/api/rates').then(function(r){return r.json()}).then(function(d){
    var f=function(n){return n.toLocaleString('ru-RU',{minimumFractionDigits:2,maximumFractionDigits:2})};
    var h=document.getElementById('rates');
    if(h)h.innerHTML=d.rates.filter(function(x){return x.ccy==='USD'||x.ccy==='EUR'}).map(function(x){
      return '<div><b>'+x.ccy+'</b>'+f(x.rate)+' <small class="'+(x.diff>=0?'up':'')+'">'+(x.diff>0?'+':'')+x.diff+'</small></div>'}).join('');
    var t=document.getElementById('rt');
    if(t){t.innerHTML=d.rates.map(function(x){
      return '<tr><td><b>'+x.ccy+'</b></td><td>'+f(x.rate)+'</td><td class="'+(x.diff>=0?'up':'dn')+'">'+(x.diff>0?'+':'')+x.diff+'</td></tr>'}).join('');
      var dd=document.getElementById('rd');if(dd&&d.rates[0])dd.textContent=d.rates[0].date}
  }).catch(function(){});
}
loadRates();
setInterval(loadRates, 60000);
`;
---
{type === 'home' && await (async () => {
  const feat = mine.filter((a) => a.data.featured).slice(0, 5);
  const slides = feat.length ? feat : mine.slice(0, 5);
  const { up } = await eventsFor(locale);
  return (
    <Base locale={locale} title="Updaily — Startup & Business Media" description={t(locale, 'latest')} path={L()} alts={allLocales('/')}>
      <div class="ticker">
        <div class="ticker-track">
          {[...mine.slice(0, 10), ...mine.slice(0, 10)].map((a) => (
            <a href={articleUrl(a)}>{a.data.title}</a>
          ))}
        </div>
      </div>

      <div class="hero-split">
        <div class="hero-main">
          <div class="slider">
            {slides.map((a) => (
              <a class="slide" href={articleUrl(a)}>
                {a.data.cover && <img src={a.data.cover} alt={a.data.coverAlt ?? a.data.title} width="1280" height="800" />}
                <h2>{a.data.title}</h2>
              </a>
            ))}
          </div>
          <div class="tools">
            <a class="rates" id="rates" href={L('/rates')} aria-label={t(locale, 'rates')}></a>
          </div>
        </div>
        <aside class="hero-latest">
          <h2 class="hero-title">{t(locale, 'latest')}</h2>
          {mine.slice(0, 3).map((a) => (
            <a class="hero-item" href={articleUrl(a)}>
              {a.data.cover && <img src={a.data.cover} alt={a.data.coverAlt ?? a.data.title} width="120" height="75" loading="lazy" />}
              <div>
                <h3>{a.data.title}</h3>
                <small>{t(locale, a.data.category)} · {fmtDate(a.data.date)}</small>
              </div>
            </a>
          ))}
        </aside>
      </div>
      <main class="wrap">
        <Ad slot="home-top" locale={locale} />
        <h2 class="h2">{t(locale, 'news')}</h2>
        {mine.slice(0, 45).map((a, i) => (
          <>
            <div data-more hidden={i >= 15}><Row a={a} locale={locale} /></div>
            {i === 4 && <Ad slot="home-middle" locale={locale} />}
          </>
        ))}
        {mine.length > 15 && <button class="more" id="more" type="button">{t(locale, 'more')}</button>}
        {up.length > 0 && (
          <section>
            <h2 class="h2">{t(locale, 'events')}</h2>
            {up.slice(0, 5).map((e) => <EventItem e={e} locale={locale} />)}
            <a class="alllink" href={L('/events')}>{t(locale, 'calendar')} →</a>
          </section>
        )}
      </main>
      <script is:inline set:html={ratesScript}></script>
      <script is:inline>
        (function(){var b=document.getElementById('more');if(!b)return;b.addEventListener('click',function(){
          var h=document.querySelectorAll('[data-more][hidden]');for(var i=0;i<15&&i<h.length;i++)h[i].hidden=false;
          if(!document.querySelector('[data-more][hidden]'))b.remove()})})();
      </script>
