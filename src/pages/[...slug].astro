---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Row from '../components/Row.astro';
import Share from '../components/Share.astro';
import Ad from '../components/Ad.astro';
import EventItem from '../components/EventItem.astro';
import { locales, defaultLocale, categories, localePath, months, t, type Locale } from '../i18n/config';
import { allArticles, byLocale, slugOf, alternates, readMin, fmtDate, articleUrl, eventsFor, getPage, PAGE_SLUGS, settings } from '../lib/content';

export async function getStaticPaths() {
  const all = await allArticles();
  const authors = await getCollection('authors');
  const events = await getCollection('events');
  const out: any[] = [];
  for (const l of locales) {
    const pre = l === defaultLocale ? '' : l;
    const j = (p: string) => [pre, p].filter(Boolean).join('/') || undefined;
    out.push({ params: { slug: j('') }, props: { type: 'home', locale: l } });
    out.push({ params: { slug: j('search') }, props: { type: 'search', locale: l } });
    out.push({ params: { slug: j('events') }, props: { type: 'events', locale: l } });
    out.push({ params: { slug: j('rates') }, props: { type: 'rates', locale: l } });
    for (const c of categories) out.push({ params: { slug: j(`c/${c}`) }, props: { type: 'category', locale: l, category: c } });
    for (const p of PAGE_SLUGS) out.push({ params: { slug: j(p) }, props: { type: 'page', locale: l, page: p } });
    for (const a of authors) out.push({ params: { slug: j(`author/${a.id}`) }, props: { type: 'author', locale: l, authorId: a.id } });
    for (const e of events) if (e.data.lang === 'all' || e.data.lang === l) out.push({ params: { slug: j(`events/${e.id}`) }, props: { type: 'event', locale: l, eventId: e.id } });
    for (const a of byLocale(all, l)) out.push({ params: { slug: j(`a/${slugOf(a)}`) }, props: { type: 'article', locale: l, id: a.id } });
  }
  return out;
}

const { type, locale, category, id, page, authorId, eventId } = Astro.props as {
  type: string; locale: Locale; category?: string; id?: string; page?: string; authorId?: string; eventId?: string;
};
const all = await allArticles();
const mine = byLocale(all, locale);
const authors = await getCollection('authors');
const L = (p = '/') => localePath(locale, p);
const allLocales = (p: string) => Object.fromEntries(locales.map((l) => [l, localePath(l, p)]));
const site = Astro.site!.toString().replace(/\/$/, '');
const contact = (settings as any).contact;
const ratesScript = `
function loadRates(){
  fetch('/api/rates').then(function(r){return r.json()}).then(function(d){
    var f=function(n){return n.toLocaleString('ru-RU',{minimumFractionDigits:2,maximumFractionDigits:2})};
    var h=document.getElementById('rates');
    if(h)h.innerHTML=d.rates.filter(function(x){return x.ccy==='USD'||x.ccy==='EUR'}).map(function(x){
      return '<div><b>'+x.ccy+'</b>'+f(x.rate)+' <small class="'+(x.diff>=0?'up':'')+'">'+(x.diff>0?'+':'')+x.diff+'</small></div>'}).join('');
    var t=document.getElementById('rt');
    if(t){t.innerHTML=d.rates.map(function(x){
      return '<tr><td><b>'+x.ccy+'</b></td><td>'+f(x.rate)+'</td><td class="'+(x.diff>=0?'up':'dn')+'">'+(x.diff>0?'+':'')+x.diff+'</td></tr>'}).join('');
      var dd=document.getElementById('rd');if(dd&&d.rates[0])dd.textContent=d.rates[0].date}
  }).catch(function(){});
}
loadRates();
setInterval(loadRates, 60000);
`;
---
{type === 'home' && await (async () => {
  const feat = mine.filter((a) => a.data.featured).slice(0, 5);
  const slides = feat.length ? feat : mine.slice(0, 5);
  const { up } = await eventsFor(locale);
  return (
    <Base locale={locale} title="Updaily — Startup & Business Media" description={t(locale, 'latest')} path={L()} alts={allLocales('/')}>
      <div class="ticker">
        <div class="ticker-track">
          {[...mine.slice(0, 10), ...mine.slice(0, 10)].map((a) => (
            <a href={articleUrl(a)}>{a.data.title}</a>
          ))}
        </div>
      </div>

            <div class="hero-split">
        <div class="hero-main">
          <div class="slider">
            {slides.map((a) => (
              <a class="slide" href={articleUrl(a)}>
                {a.data.cover && <img src={a.data.cover} alt={a.data.coverAlt ?? a.data.title} width="1280" height="800" />}
                <h2>{a.data.title}</h2>
              </a>
            ))}
          </div>
          <div class="tools">
            <a class="rates" id="rates" href={L('/rates')} aria-label={t(locale, 'rates')}></a>
            <a class="ic" href={L('/search')} aria-label={t(locale, 'search')}>⌕</a>
          </div>
        </div>
        <aside class="hero-latest">
          <h2 class="hero-title">{t(locale, 'latest')}</h2>
          {mine.slice(0, 3).map((a) => (
            <a class="hero-item" href={articleUrl(a)}>
              {a.data.cover && <img src={a.data.cover} alt={a.data.coverAlt ?? a.data.title} width="120" height="75" loading="lazy" />}
              <div>
                <h3>{a.data.title}</h3>
                <small>{t(locale, a.data.category)} · {fmtDate(a.data.date)}</small>
              </div>
            </a>
          ))}
        </aside>
      </div>
                  <div class="tools">
            <div class="rates-card">
              <div class="rates-head">
                <span class="rates-badge">🏦</span>
                <div>
                  <b>Markaziy bank kursi</b>
                  <small>Rasmiy kurslar</small>
                </div>
              </div>
              <a class="rates" id="rates" href={L('/rates')} aria-label={t(locale, 'rates')}></a>
            </div>
            <a class="ic search-ic" href={L('/search')} aria-label={t(locale, 'search')}>⌕</a>
          </div>
            </a>
          ))}
        </aside>
      </div>
      <main class="wrap">
        <Ad slot="home-top" locale={locale} />
        <h2 class="h2">{t(locale, 'latest')}</h2>
        {mine.slice(0, 45).map((a, i) => (
          <>
            <div data-more hidden={i >= 15}><Row a={a} locale={locale} /></div>
            {i === 4 && <Ad slot="home-middle" locale={locale} />}
          </>
        ))}
        {mine.length > 15 && <button class="more" id="more" type="button">{t(locale, 'more')}</button>}
        {up.length > 0 && (
          <section>
            <h2 class="h2">{t(locale, 'events')}</h2>
            {up.slice(0, 5).map((e) => <EventItem e={e} locale={locale} />)}
            <a class="alllink" href={L('/events')}>{t(locale, 'calendar')} →</a>
          </section>
        )}
      </main>
      <script is:inline set:html={ratesScript}></script>
      <script is:inline>
        (function(){var b=document.getElementById('more');if(!b)return;b.addEventListener('click',function(){
          var h=document.querySelectorAll('[data-more][hidden]');for(var i=0;i<15&&i<h.length;i++)h[i].hidden=false;
          if(!document.querySelector('[data-more][hidden]'))b.remove()})})();
      </script>
    </Base>
  );
})()}

{type === 'category' && (
  <Base locale={locale} title={t(locale, category!)} description={t(locale, category!)} path={L(`/c/${category}`)} alts={allLocales(`/c/${category}`)} cat={category}>
    <main class="wrap">
      <h1 class="h2">{t(locale, category!)}</h1>
      {mine.filter((a) => a.data.category === category).map((a) => <Row a={a} locale={locale} />)}
    </main>
  </Base>
)}

{type === 'search' && (
  <Base locale={locale} title={t(locale, 'search')} description={t(locale, 'search')} path={L('/search')} alts={allLocales('/search')}>
    <main class="wrap">
      <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
      <div id="search" style="margin-top:16px"></div>
      <script is:inline src="/pagefind/pagefind-ui.js"></script>
      <script is:inline>window.addEventListener('DOMContentLoaded',function(){new PagefindUI({element:'#search',showImages:false,showSubResults:false})})</script>
    </main>
  </Base>
)}

{type === 'rates' && (
  <Base locale={locale} title={t(locale, 'rates')} description={t(locale, 'rateNote')} path={L('/rates')} alts={allLocales('/rates')}>
    <main class="wrap narrow">
      <h1 class="h2">{t(locale, 'rates')}</h1>
      <div class="ep">{t(locale, 'rateNote')} · <span id="rd"></span></div>
      <table><tbody id="rt"></tbody></table>
    </main>
    <script is:inline set:html={ratesScript}></script>
  </Base>
)}

{type === 'events' && await (async () => {
  const { up, past } = await eventsFor(locale);
  return (
    <Base locale={locale} title={t(locale, 'calendar')} description={t(locale, 'calendar')} path={L('/events')} alts={allLocales('/events')}>
      <main class="wrap narrow">
        <h1 class="h2">{t(locale, 'upcoming')}</h1>
        {up.map((e) => <EventItem e={e} locale={locale} />)}
        {past.length > 0 && (<><h2 class="h2">{t(locale, 'past')}</h2>{past.map((e) => <EventItem e={e} locale={locale} />)}</>)}
      </main>
    </Base>
  );
})()}

{type === 'event' && await (async () => {
  const ev = (await getCollection('events')).find((x) => x.id === eventId)!;
  const { Content } = await render(ev);
  const d = ev.data;
  const dt = d.date;
  const dateStr = `${dt.getUTCDate()} ${months[locale][dt.getUTCMonth()]} ${dt.getUTCFullYear()}`;
  const map = d.map ?? (d.place ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(d.place)}` : undefined);
  const iso = dt.toISOString().slice(0, 10);
  const hm = d.time?.match(/^(\d{1,2}):(\d{2})/);
  const start = hm ? `${iso}T${hm[1].padStart(2, '0')}:${hm[2]}:00+05:00` : iso;
  const p = L(`/events/${ev.id}`);
  const ld = {
    '@context': 'https://schema.org', '@type': 'Event', name: d.title, startDate: start, description: d.summary,
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: d.place ? { '@type': 'Place', name: d.place } : undefined,
    image: d.image ? `${site}${d.image}` : undefined, url: `${site}${p}`,
  };
  return (
    <Base locale={locale} title={d.title} description={d.summary ?? d.title} path={p} image={d.image} jsonLd={ld}
      alts={d.lang === 'all' ? allLocales(`/events/${ev.id}`) : { [locale]: p }}>
      <article class="wrap narrow">
        <div class="crumbs"><a href={L()}>{t(locale, 'home')}</a> / <a href={L('/events')}>{t(locale, 'events')}</a></div>
        <h1>{d.title}</h1>
        <div class="info"><span class="cat">{dateStr}{d.time && ` · ${d.time}`}</span></div>
        {d.image && <img class="cover" src={d.image} alt={d.title} width="1280" height="720" fetchpriority="high" />}
        {d.summary && <p class="prose">{d.summary}</p>}
        {d.place && <div class="keybox"><b>{t(locale, 'where')}</b><div>{d.place}</div></div>}
        <div class="btns">
          {map && <a class="btn" href={map} target="_blank" rel="noopener">{t(locale, 'openMap')}</a>}
          {d.url && <a class="btn ghost" href={d.url} target="_blank" rel="noopener">{t(locale, 'register')}</a>}
        </div>
        <div class="prose"><Content /></div>
      </article>
    </Base>
  );
})()}

{type === 'page' && await (async () => {
  const entry = (await getPage(page!, locale))!;
  const { Content } = await render(entry);
  const team = page === 'about' ? authors.filter((a) => a.data.team) : [];
  return (
    <Base locale={locale} title={entry.data.title} description={entry.data.description ?? ''} path={L(`/${page}`)} alts={allLocales(`/${page}`)}
      jsonLd={page === 'about' ? { '@context': 'https://schema.org', '@type': 'AboutPage', name: entry.data.title, url: `${site}${L('/about')}` } : undefined}>
      <main class="wrap narrow">
        <h1 class="h2">{entry.data.title}</h1>
        <div class="prose"><Content /></div>
        {team.length > 0 && (
          <>
            <h2 class="h2">{t(locale, 'team')}</h2>
            <div class="team">
              {team.map((a) => (
                <a class="card" href={L(`/author/${a.id}`)}><b>{a.data.name}</b><div class="ep">{a.data.role}</div></a>
              ))}
            </div>
          </>
        )}
      </main>
    </Base>
  );
})()}

{type === 'author' && (() => {
  const au = authors.find((x) => x.id === authorId)!;
  const list = mine.filter((a) => a.data.author === au.id);
  const same = [au.data.linkedin, au.data.telegram].filter(Boolean);
  const ld = {
    '@context': 'https://schema.org', '@type': 'Person', name: au.data.name, url: `${site}${L(`/author/${au.id}`)}`,
    jobTitle: au.data.role, worksFor: { '@type': 'Organization', name: 'Updaily', url: site },
    sameAs: same, knowsAbout: au.data.expertise, image: au.data.photo ? `${site}${au.data.photo}` : undefined,
  };
  return (
    <Base locale={locale} title={`${au.data.name}${au.data.role ? ' — ' + au.data.role : ''}`} description={au.data.bio ?? au.data.name}
      path={L(`/author/${au.id}`)} alts={allLocales(`/author/${au.id}`)} jsonLd={ld}>
      <main class="wrap narrow">
        <div class="author" style="margin-top:20px">
          {au.data.photo && <img src={au.data.photo} alt={au.data.name} width="48" height="48" />}
          <div><h1 style="margin:0;font-size:26px">{au.data.name}</h1>{au.data.role && <small>{au.data.role}</small>}</div>
        </div>
        {au.data.bio && <p class="prose">{au.data.bio}</p>}
        {au.data.expertise.length > 0 && (<><div class="lbl">{t(locale, 'expertise')}</div><div class="tags">{au.data.expertise.map((x) => <span>{x}</span>)}</div></>)}
        {same.length > 0 && <p>{same.map((u) => <a class="ul" href={u as string} target="_blank" rel="noopener me">{(u as string).includes('linkedin') ? 'LinkedIn' : 'Telegram'}</a>).reduce((a: any, b: any) => [a, ' · ', b] as any)}</p>}
        {list.length > 0 && (<><h2 class="h2">{t(locale, 'articlesBy')}</h2>{list.map((a) => <Row a={a} locale={locale} />)}</>)}
      </main>
    </Base>
  );
})()}

{type === 'article' && await (async () => {
  const a = all.find((x) => x.id === id)!;
  const { Content } = await render(a);
  const d = a.data;
  const author = authors.find((x) => x.id === d.author);
  const url = `${site}${articleUrl(a)}`;
  const desc = d.seoDescription ?? d.summary ?? (a.body ?? '').replace(/\s+/g, ' ').slice(0, 160);
  const related = mine.filter((x) => x.id !== a.id && x.data.category === d.category).slice(0, 4);
  const ld = {
    '@context': 'https://schema.org', '@type': 'NewsArticle', headline: d.title, description: desc, inLanguage: locale,
    datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(),
    image: d.cover ? `${site}${d.cover}` : undefined, mainEntityOfPage: url,
    author: author
      ? { '@type': 'Person', name: author.data.name, url: `${site}${L(`/author/${author.id}`)}` }
      : { '@type': 'Organization', name: 'Updaily' },
    publisher: { '@type': 'Organization', name: 'Updaily', logo: { '@type': 'ImageObject', url: `${site}/logo.png` } },
  };
  const mail = `mailto:${contact.email}?subject=${encodeURIComponent('Xato: ' + d.title)}&body=${encodeURIComponent(url)}`;
  return (
    <Base locale={locale} title={d.seoTitle ?? d.title} description={desc} path={articleUrl(a)} alts={alternates(all, a)} image={d.cover} type="article" jsonLd={ld} cat={d.category}>
      <article class="wrap narrow" data-pagefind-body>
        <div class="crumbs"><a href={L()}>{t(locale, 'home')}</a> / <a href={L(`/c/${d.category}`)}>{t(locale, d.category)}</a></div>
        <h1>{d.title}</h1>
        <div class="info">
          <span class="cat">{t(locale, d.category)}</span>
          <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
          <span>{readMin(a.body)} {t(locale, 'minRead')}</span>
          {d.updated && <span>{t(locale, 'updated')}: {fmtDate(d.updated)}</span>}
          {d.sponsored && <span class="badge">{t(locale, 'sponsored')}</span>}
        </div>
        {d.cover && <img class="cover" src={d.cover} alt={d.coverAlt ?? d.title} width="1280" height="720" fetchpriority="high" />}
        <Share url={url} title={d.title} locale={locale} />
        {(d.summary || d.keyPoints.length > 0) && (
          <div class="keybox">
            <b>{t(locale, 'summary')}</b>
            {d.summary && <div>{d.summary}</div>}
            {d.keyPoints.length > 0 && <ul>{d.keyPoints.map((k) => <li>{k}</li>)}</ul>}
          </div>
        )}
        <div class="prose"><Content /></div>
        <Ad slot="article-middle" locale={locale} id="ad-mid" />
        {d.sources.length > 0 && (
          <>
            <div class="lbl">{t(locale, 'sources')}</div>
            <ul class="src">{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>)}</ul>
          </>
        )}
        <hr />
        <div class="lbl">{t(locale, 'author')}</div>
        {author ? (
          <a class="author" href={L(`/author/${author.id}`)}>
            {author.data.photo && <img src={author.data.photo} alt={author.data.name} width="48" height="48" />}
            <span>{author.data.name}{author.data.role && <small>{author.data.role}</small>}</span>
          </a>
        ) : <div class="author"><span>Updaily</span></div>}
        <a class="rep" href={mail}>{t(locale, 'report')}</a>
        {d.tags.length > 0 && (<><div class="lbl">{t(locale, 'tags')}</div><div class="tags">{d.tags.map((x) => <span>{x}</span>)}</div></>)}
        <h2 class="h2">{t(locale, 'follow')}</h2>
        <Share url={url} title={d.title} locale={locale} />
        <Ad slot="article-bottom" locale={locale} />
        {related.length > 0 && (<><h2 class="h2">{t(locale, d.category)}</h2>{related.map((x) => <Row a={x} locale={locale} />)}</>)}
      </article>
    </Base>
  );
})()}

<style>
  .ticker {
    overflow: hidden;
    white-space: nowrap;
    background: #e11d2e;
    color: #fff;
    padding: 8px 0;
    margin-bottom: 16px;
  }
  .ticker-track {
    display: inline-flex;
    gap: 48px;
    padding-left: 100%;
    animation: ticker 40s linear infinite;
  }
  .ticker-track a {
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }
  .ticker:hover .ticker-track { animation-play-state: paused; }
  @keyframes ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-100%); }
  }

  .hero-split {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 24px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
    align-items: start;
  }
  .hero-main { min-width: 0; }
  .hero-main .slider img {
    width: 100%;
    height: 340px;
    object-fit: cover;
    display: block;
  }
  .hero-title {
    margin: 0 0 12px;
    font-size: 20px;
    padding-bottom: 8px;
    border-bottom: 2px solid #e11d2e;
  }
  .hero-item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(128, 128, 128, .25);
    color: inherit;
    text-decoration: none;
  }
  .hero-item img {
    width: 120px;
    height: 75px;
    object-fit: cover;
    border-radius: 6px;
  }
  .hero-item h3 {
    margin: 0 0 6px;
    font-size: 15px;
    line-height: 1.35;
    font-weight: 600;
  }
  .hero-item:hover h3 { color: #e11d2e; }
  .hero-item small { opacity: .6; font-size: 12px; }
  @media (max-width: 768px) {
    .hero-split { grid-template-columns: 1fr; }
    .hero-main .slider img { height: auto; aspect-ratio: 16 / 9; }
  }
</style>
